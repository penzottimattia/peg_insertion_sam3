{
  "title": "Method comparison across peg tolerances",
  "font_name": "DejaVu Sans",
  "font_size": 10,
  "tolerance_label": "Peg tolerance (mm)",
  "insertion_depth_threshold": 20.0,
  "normalization_type": "zscore",
  "normalization_scope": "group",
  "linear_analysis": {
    "enabled": true,
    "show_fit": true,
    "show_statistics": true,
    "confidence_band": false,
    "alpha": 0.05,
    "line_width": 1.8
  },
  "methods": [
    {
      "name": "method_a",
      "label": "Method A",
      "color": "#0072B2"
    },
    {
      "name": "method_b",
      "label": "Method B",
      "color": "#D55E00"
    }
  ],
  "datasets": [
    {
      "method": "method_a",
      "tolerance": 0.5,
      "data_dirs": [
        "/path/to/method_a_tol_0_5_part_1",
        "/path/to/method_a_tol_0_5_part_2"
      ]
    },
    {
      "method": "method_b",
      "tolerance": 0.5,
      "data_dirs": [
        "/path/to/method_b_tol_0_5"
      ]
    },
    {
      "method": "method_a",
      "tolerance": 1.0,
      "data_dirs": [
        "/path/to/method_a_tol_1_0"
      ]
    },
    {
      "method": "method_b",
      "tolerance": 1.0,
      "data_dirs": [
        "/path/to/method_b_tol_1_0_part_1",
        "/path/to/method_b_tol_1_0_part_2"
      ]
    }
  ],
  "show_datapoint_ids": true,
  "shade_failure_region": false,
  "scatter_summary_bars": true,
  "scatter_success_failure_bars": true,
  "video_gallery": {
    "shallow_engagement_depth_mm": 2.0,
    "fps": 30.0,
    "cell_width": 320,
    "cell_height": 240,
    "seed": 0,
    "truncate_at_max_depth": false,
    "group_by_tolerance": true,
    "highlight_early_seconds": 0.0,
    "anomalous_depth_mm": null
  }
}
